# Sekuritas CMS — Environment Variables
# Copy this file to .env and fill in your actual values

# API Base URL for Laravel backend
NUXT_PUBLIC_API_BASE=https://api.hamztech.my.id/api/cms

# App environment
NODE_ENV=production

# Optional: Port override (default 3000)
# PORT=3000

# Optional: Base URL if deploying to a subdirectory
# NUXT_APP_BASE_URL=/cms/
